# TreasuryTakeHome environment template. Copy to `.env.local` and fill in.
# `.env.local` is gitignored — never commit real secrets.

# --- Core (existing) ---------------------------------------------------------
# OpenAI GPT-4o for label-image extraction + match explanations.
OPENAI_API_KEY=

# --- Auth.js (Stage 3: reviewer/admin auth) ----------------------------------
# Secret used to sign/encrypt JWT session tokens. Generate with:
#   openssl rand -base64 32   (or: npx auth secret)
# Required only when auth is exercised at runtime; tests never need it.
AUTH_SECRET=

# Postgres connection string (shared by Vercel API routes and the worker).
# Used by the Credentials provider's authorize() and by `npm run seed`.
# Vercel functions should point at the pooled/pgbouncer endpoint.
DATABASE_URL=

# Durable-batch feature flag. "1" turns ON reviewer/admin route gating in
# middleware; anything else (or unset) keeps the public core fully open.
DURABLE_BATCH=

# Demo/staging seed passwords for `npm run seed` (reviewer@ttb.gov / admin@ttb.gov).
# Dev defaults exist in lib/db/seed.ts; override here for any shared environment.
SEED_REVIEWER_PASSWORD=
SEED_ADMIN_PASSWORD=
